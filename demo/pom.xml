<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.solace.mendix.amqp</groupId>
        <artifactId>mendix-amqp-broker-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>amqp-broker-demo</artifactId>
    <packaging>jar</packaging>
    <name>AMQP Multi-Broker Connector - Standalone Demo</name>

    <dependencies>
        <dependency>
            <groupId>com.solace.mendix.amqp</groupId>
            <artifactId>amqp-broker-connector</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
        </dependency>
        <!--
          Embedded ActiveMQ Artemis broker dependencies - commented out for
          now. As of the latest Artemis release (2.56.0), starting an
          embedded broker on JDK 24+ crashes with
          "UnsupportedOperationException: getSubject is not supported"
          (see README.md, "Why the embedded ActiveMQ demo mode is
          disabled"). The demo now defaults to a local Solace PubSub+
          software broker running in Docker instead - see README.md,
          "Local broker for testing". Re-enable these two dependencies
          (and EmbeddedBrokerLauncher.java) once upstream Artemis fixes
          JDK 24+ support: https://issues.apache.org/jira/browse/ARTEMIS-5374
        <dependency>
            <groupId>org.apache.artemis</groupId>
            <artifactId>artemis-server</artifactId>
            <version>${artemis.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.artemis</groupId>
            <artifactId>artemis-amqp-protocol</artifactId>
            <version>${artemis.version}</version>
        </dependency>
        -->
    </dependencies>

    <build>
        <finalName>amqp-broker-demo</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.solace.mendix.amqp.demo.DemoApp</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>

                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
